<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beanalytic.inplay-walkforward-weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@@REPO_ROOT@@/scripts/inplay_walkforward_cron.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@REPO_ROOT@@</string>

    <!-- Domingo às 07:18 (horário local do macOS) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>18</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>@@REPO_ROOT@@/data/lake/logs/inplay_walkforward_launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>@@REPO_ROOT@@/data/lake/logs/inplay_walkforward_launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
