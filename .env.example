# Caminho local do datalake (camadas bronze/silver/gold)
LAKE_ROOT=./data/lake
# Dev (recomendado — sem custo GCP):
LAKE_PRIMARY=local
LAKE_SYNC_BQ_ON_WRITE=false
# Produção / publicar na nuvem:
# LAKE_PRIMARY=cloud
# LAKE_SYNC_BQ_ON_WRITE=true

# Janela de coleta (dias retroativos para RSS)
COLLECT_LOOKBACK_DAYS=7
# Máx. itens por feed RSS (5 fontes × 160 ≈ 800 artigos por sync)
# RSS_MAX_ENTRIES_PER_SOURCE=160
# NEWS_BODY_PREVIEW_MAX_CHARS=   # vazio = sem corte no body_preview/summary da API
# NEWS_SYNC_FETCH_BODY=false    # padrão no código: true (texto completo nas matérias)

# BigQuery / GCS (pip install -e ".[gcp]")
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/sua-service-account.json
# GCP_PROJECT=
# BQ_DATASET=sports_news_lake
# GCS_BUCKET=beanalytic-dev-sports-news-lake
# Requer bucket criado no GCP + IAM na service account (Storage Object Admin).
# Sem GCS_BUCKET o sync-gcp carrega Parquet local direto no BQ (fallback dev).
# sync-gcp --list-layers
# sync-gcp --layer all --truncate
# sync-gcp --layer silver_sofascore  → silver_sofascore_match_stats
# sync-gcp --layer bronze_sofascore  → bronze_sofascore_events
# sync-gcp --layer gold_wc           → gold_wc_match_features

# Consultas SQL locais no lake (pip install -e ".[analytics]")
# lake-query --preset summary

# NER de jogadores (pip install -e ".[ner]")
# NER_ENABLED=true
# NER_MODEL=pierreguillou/ner-bert-base-cased-pt-lenerbr

# Copa do Mundo — holdout de validação (arquivo world_cup_{ano}.parquet)
# WC_VALIDATION_SEASON=2022
# Opção B treino: labels só jogos de Copa; features usam histórico FIFA/Sofascore
# WC_TRAIN_LABELS_COPA_ONLY=true
# WC_TRAIN_INCLUDE_FIFA_HISTORY=true
# Split treino/validação/teste: temporal 80/10/10 cronológico (padrão) ou holdout por edição
# WC_HOLDOUT_MODE=temporal
# WC_TRAIN_SPLIT_RATIO=0.8
# WC_VAL_SPLIT_RATIO=0.1
# WC_TEST_SPLIT_RATIO=0.1

# Marco teórico (economics.py)
# LGN_MIN_SAMPLES=30
# LGN_BOOTSTRAP_SAMPLES=2000
# EV_MIN_EDGE=0.03
# COASE_BOOKMAKER_MARGIN=0.05
# COASE_TRANSACTION_COST=0.0
# DIXIT_SIGMA=2.0

# API-Football (enriquecimento gold)
# API_FOOTBALL_KEY=

# Sofascore (ingest-sofascore — FEPT automático; requer pip install -e ".[sofascore]")
# SOFASCORE_BASE_URL=https://api.sofascore.com/api/v1
# SOFASCORE_IMPERSONATE=chrome124
# SOFASCORE_MIN_INTERVAL_SEC=0.12
# SOFASCORE_WAF_COOLDOWN_SEC=900
# INPLAY_SOFASCORE_WAF_MAX_RETRIES=0
# SOFASCORE_FEPT_DIR=data/lake/fept
# SOFASCORE_STATS_DIR=data/lake/sofascore

# Odds API (tempo real)
# Registre sua chave em: https://the-odds-api.com/
# ODDS_API_KEY=
# ODDS_DEFAULT_SPORT=soccer_fifa_world_cup
# ODDS_DEFAULT_REGIONS=eu
# ODDS_DEFAULT_MARKETS=h2h
# ODDS_DEFAULT_ODDS_FORMAT=decimal
# SUREBET_MIN_MARGIN_PCT=0.3
# SUREBET_DEFAULT_BANKROLL=1000

# Modelo de bolão (LM local; fallback automático para baseline)
# BOLAO_MODEL_PATH=models/checkpoints/bolao-unsloth
# BOLAO_USE_LM=true
# BOLAO_LM_BASE_MODEL=unsloth/Qwen2.5-0.5B-Instruct

# MLflow (train-wc --mlflow, benchmark --mlflow + mlflow-ui)
# MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
# MLFLOW_EXPERIMENT_WC=api-noticia/wc-benchmark
# MLFLOW_EXPERIMENT_WC_TRAIN=api-noticia/wc-train
# MLFLOW_EXPERIMENT_BOLAO=api-noticia/bolao-benchmark
# Seleção automática do melhor modelo WC em /worldcup/predict (sem retreino)
# WC_MODEL_SELECTION_MODE=auto
# WC_MODEL_SELECTION_METRIC=brier
# WC_MODEL_SELECTION_SOURCE=benchmark

# Basquete In-Play (NBA / Superbet)
# BASKET_SPORT_ID=4              # Basquete na Superbet BR (sport_id 70 = E-Sport Basquete/NBA2K, categoria distinta)
# BASKET_MATCH_MINUTES=40        # feed virtual/simulado da Superbet: 4 quartos de 10min
# BASKET_MC_SIMULATIONS=5000
# BASKET_FAST_MC_SIMULATIONS=1500
# BASKET_PRIOR_WEIGHT=96.0       # minutos-equivalente de confiança no prior de mercado (~2 jogos NBA)
# BASKET_CLUTCH_MINUTE=35        # últimos 5 minutos (jogo de 40min): aumenta variância
# BASKET_CLUTCH_BOOST_ENABLED=true
# BASKET_CLUTCH_BOOST=1.15
# BASKET_LEAD_ADMIN_FACTOR=0.92  # time vencendo administra ritmo
# BASKET_TRAILING_PUSH_FACTOR=1.08  # time perdendo força faltas/3pts
# BASKET_SIGMA_PPM=0.35          # desvio padrão de pontos por minuto (calibrável)
# BASKET_SPREAD_LINES=[-12.5,-9.5,-7.5,-5.5,-4.5,-3.5,-2.5,-1.5,1.5,2.5,3.5,4.5,5.5,7.5,9.5,12.5]
# BASKET_TOTAL_LINES=[205.5,210.5,215.5,220.5,225.5,230.5]

# API
API_HOST=0.0.0.0
API_PORT=8000
# Protege rotas quando definida (vírgula = várias chaves válidas). Dev local pode omitir.
# API_KEY=sua-chave-secreta
# O frontend em dev reutiliza API_KEY (vite.config); em build use VITE_API_KEY com o mesmo valor.

# Widget Sportradar LMT Plus — tracker ao vivo idêntico ao da Superbet (feed Betradar)
# Obtenha o client id com a Sportradar/Betradar (licença + domínio autorizado: localhost, fly.io, etc.)
# SPORTRADAR_CLIENT_ID=seu-client-id-de-32-chars
# SPORTRADAR_LANGUAGE=pt_br

# Fase 1 in-play (docs/specs/spec-fase-1-quickwins-inplay.md)
# INPLAY_FAST_MC_SIMULATIONS=1500
# INPLAY_USE_NHPP=true
# INPLAY_USE_MARKET_SHRINKAGE=true
# INPLAY_MOMENTUM_ON_REMAINING=true
# INPLAY_SCORE_LAMBDA_ADJUST=false
# INPLAY_SCORE_LAMBDA_ADJUST_WITH_SOFASCORE=true
# INPLAY_SYNTHETIC_TICK_WEIGHT=2.0
# INPLAY_SYNTHETIC_MIN_EXAMPLES=50
# INPLAY_USE_CALIBRATED_COEFFICIENTS=true
# INPLAY_USE_CALIBRATED_NHPP=false
# INPLAY_USE_ENSEMBLE=true
# INPLAY_ENSEMBLE_HAWKES=true
# INPLAY_ENSEMBLE_GBM=true
# INPLAY_ENSEMBLE_SHADOW_MODE=true
# INPLAY_ENSEMBLE_AB_LOG_TICKS=true
# INPLAY_ENSEMBLE_MIN_FEEDBACK_HI=150
# INPLAY_ENSEMBLE_PROD_FEEDBACK_HI=500
# INPLAY_ENSEMBLE_MIN_TICK_EXAMPLES=150
# INPLAY_ENSEMBLE_MIN_INPLAY_DELTA=0.015
# check-inplay-ensemble — gate shadow → produção
# INPLAY_USE_SOFASCORE_LIVE=true
# INPLAY_HALFTIME_ADJUST=true
# COMBO_LAST10_FETCH_INCIDENTS=false  # busca incidentes Sofascore para validar 1T (lento; WAF)
# WALLET_DASHBOARD_ENABLED=true
# Carteira — inbox CSV semi-automática (docs/roadmap-plataforma-ml.md)
# Exporte CSV na Superbet → salve em data/lake/inbox/wallet/{user_id}/
# watch-wallet-csv --user jamarorn   (ou cron semanal)
# WALLET_INBOX_ENABLED=true
# WALLET_INBOX_DIR=inbox/wallet
# WALLET_INBOX_AUTO_RECONCILE=true
# WALLET_INBOX_STALE_DAYS=7

# Palpite WC — empate em jogos equilibrados (fase de grupos)
# WC_DRAW_PICK_MIN_PROB=0.26
# WC_DRAW_BALANCE_GAP=0.18
# WC_DRAW_COMPETITIVE_MARGIN=0.035
# WC_FAVORITE_PROB_CAP=0.78
# WC_FAVORITE_DRAW_SHARE=0.55
# EV mínimo para exibir recomendação (camada bet_decision — padrão 0.05 = 5%)
# EV_RECOMMENDATION_MIN_THRESHOLD=0.05
# BET_DEFAULT_STAKE_BRL=10
# BET_USE_FRACTIONAL_KELLY=false
# BET_MAX_STAKE_PCT=5
# BET_STOP_LOSS_BRL=200
# LIVE_EV_MIN_EDGE=0.07
# LIVE_MIN_EDGE_PP=10.0
# LIVE_MIDGAME_STRICT_MINUTE=45
# LIVE_MIDGAME_MIN_EDGE_PP=12.0
# LIVE_BLOCK_MINUTE=45
# LIVE_HT_OVER_TRAP_MINUTE=35
# LIVE_HT_OVER_TRAP_BLOCK_DEAD=true
# LIVE_BLOCK_2H_MINUTE=82
# LIVE_HARD_STOP_MINUTE=88
# LIVE_2H_VIABLE_MIN_PROB=0.06
# LIVE_2H_VIABLE_MAX_MARKETS=12
# IMPORTANTE: LIVE_BLOCK_MINUTE bloqueia mercados FT após 45'; mercados 2T seguem até LIVE_BLOCK_2H_MINUTE
# LIVE_HARD_STOP_MINUTE bloqueia TODAS as apostas novas (extensão inclusa)
# LIVE_CASHOUT_USE_TREND=true
# WC_XG_LAMBDA_BLEND_ENABLED=true
# WC_XG_LAMBDA_BLEND_WEIGHT=0.35
# INPLAY_TUNE_MIN_SNAPSHOTS=50
# BET_GUARDRAILS_ENABLED=true
# BET_ONE_PER_MARKET_ENABLED=true
# BET_MAX_STAKE=50
# BET_REQUIRE_MINUTE_EXTENSION=true
# BET_BLOCK_MULTIS_LATE=true
# SUPER_MULTIPLA_BONUS_PCT=0.05
# SUPER_MULTIPLA_MIN_LEG_ODD=1.35
# INPLAY_USE_SOFASCORE_LIVE=false

# Cron plataforma ML: ./scripts/install-platform-cron.sh
# Atalho Copa/seleções: ./scripts/poll-wc-live.sh  (equivale a poll-superbet-live --wc-copa)
# SUPERBET_POLL_WC_ENABLED=true
# SUPERBET_POLL_INTERVAL_SEC=120
# SUPERBET_POLL_WC_PHASE=group
# SUPERBET_POLL_WATCHLIST_ENABLED=true
# SUPERBET_POLL_WATCHLIST_MAX=24
# POLL_ACTIVE_HOUR_START=10
# POLL_ACTIVE_HOUR_END=23
# POLL_TIMEZONE=America/Sao_Paulo
# POLL_MAX_EVENTS=15
# POLL_FILTER_INTERNATIONAL=true
# POLL_WC_COPA=true              # usa --wc-copa (seleções Copa)
# POLL_PHASE=group
# POLL_EVENT_IDS=13108472,13324536
# SUPERBET_GAMING_API_URL=https://api-gaming.content-prod.superbet.bet.br
# SUPERBET_CONTENT_CDN_URL=https://superbet-content.freetls.fastly.net
# SUPERBET_SITE_URL=https://superbet.bet.br
# SUPERBET_FETCH_RETRIES=2
# SUPERBET_STALE_MAX_AGE_SEC=600

# ScoreAlarm (stats/timeline ao vivo — mesma stack da Superbet)
# SCOREALARM_ENABLED=true
# SCOREALARM_BASE_URL=https://scorealarm-stats.freetls.fastly.net
# SCOREALARM_BRAND=brsuperbetsport
# SCOREALARM_LOCALE=pt-BR
# SCOREALARM_TIMEOUT_SEC=12
# SCOREALARM_FETCH_RETRIES=1

# Social Superbet (top picks in-play — protobuf/JSON; desabilitado por padrão)
# SOCIAL_TOP_PICKS_ENABLED=false
# SOCIAL_TOP_PICKS_BASE_URL=https://social-front.freetls.fastly.net
# SOCIAL_TOP_PICKS_ORIGIN=https://superbet.bet.br
# SOCIAL_TOP_PICKS_TIMEOUT_SEC=8

# λ dinâmico in-play (ScoreAlarm + timeline)
# INPLAY_SCORE_LAMBDA_ADJUST_WITH_SCOREALARM=true
# INPLAY_LIVE_STATS_LAMBDA_ADJUST=true
# INPLAY_LIVE_STATS_MAX_SHIFT=0.12
# INPLAY_TRAILING_CHASE_BOOST=true

# Finalização automática ao encerrar jogo Superbet (salva gold + retreino in-play)
# SUPERBET_FINALIZE_ENABLED=true
# SUPERBET_FINALIZE_RETRAIN=true
# SUPERBET_FINALIZE_USER_ID=jamarorn
# SUPERBET_FINALIZE_RETRAIN_GBM=true
# SUPERBET_FINALIZE_RETRAIN_FEEDBACK=true
# SUPERBET_FINALIZE_RETRAIN_COEFFICIENTS=false
# SUPERBET_FINALIZE_MIN_CONFIDENCE=0.7
# SUPERBET_FINALIZE_SETTLE_OPEN_BETS=true

# Carteira — cron semanal (scripts/wallet-reminder-cron.sh, scripts/weekly-pl-report.sh)
# wallet-reminder --user jamarorn
# weekly-pl-report --user jamarorn

# Fly.io (ver docs/deploy-fly.md)
# LAKE_ROOT=/data/lake
# WC_ARTIFACT_DIR=/data/lake/artifacts/wc_predictor
# PORT=8080

# ── Deep Research Pré-Jogo ──
# Perplexity (https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar-pro   # ou sonar (mais barato)
# Moonshot / Kimi (https://platform.moonshot.cn/)
MOONSHOT_API_KEY=sk-...
# MOONSHOT_MODEL=moonshot-v1-128k
# Google Gemini (https://aistudio.google.com/app/apikey) — provedor padrão
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash
# PREGAME_RESEARCH_CACHE_TTL_SEC=3600

# ── Copiloto ao vivo (OpenAI) ──
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# LIVE_COPILOT_ENABLED=true
# LIVE_COPILOT_POLL_ENABLED=true
# LIVE_COPILOT_MODE=narrate
# LIVE_COPILOT_MODE=agent
# LIVE_COPILOT_AUTO_UI=false
# LIVE_COPILOT_MAX_AGENT_TURNS=6
# LIVE_COPILOT_CACHE_TTL_SEC=25
# LIVE_COPILOT_TEMPERATURE=0.2
# LIVE_COPILOT_MAX_TOKENS=900
