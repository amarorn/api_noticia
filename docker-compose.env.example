# Copie para .env na raiz.

API_PORT=8000

# Dev local (padrão — ./scripts/docker-dev.sh up)
LAKE_PRIMARY=local
LAKE_SYNC_BQ_ON_WRITE=false

# Publicar na GCP (sync-gcp ou ./scripts/docker-dev.sh cloud up)
# LAKE_PRIMARY=cloud
# LAKE_SYNC_BQ_ON_WRITE=true
# GCP_CREDENTIALS_FILE=beanalytic-dev.json
GCP_PROJECT=beanalytic-dev
BQ_DATASET=sports_news_lake
GCS_BUCKET=beanalytic-dev-sports-news-lake

COLLECT_LOOKBACK_DAYS=7
NEWS_SYNC_FETCH_BODY=false

# API_KEY=
# ODDS_API_KEY=
